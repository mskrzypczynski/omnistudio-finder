{
  "manifest_version": 3,
  "name": "OmniStudio Finder",
  "version": "1.3.0",
  "description": "Find OmniScripts, Integration Procedures, DataRaptors and FlexCards in your Salesforce org. See every version, open the right one.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.cloudforce.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniStudio Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open OmniStudio Finder"
    }
  },
  "minimum_chrome_version": "121",
  "background": {
    "service_worker": "src/ui/background.js",
    "type": "module"
  }
}
